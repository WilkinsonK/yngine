# Root logger level and appenders
log4cplus.rootLogger=@LOGLEVEL@, STDOUT, FILE

# Default Console appender
log4cplus.appender.STDOUT=log4cplus::ConsoleAppender
log4cplus.appender.STDOUT.layout=log4cplus::PatternLayout
log4cplus.appender.STDOUT.layout.ConversionPattern=@LOGLAYOUT_ROOT@

# File appender
log4cplus.appender.FILE=log4cplus::RollingFileAppender
log4cplus.appender.FILE.File=@LOG_OUTFILE@
log4cplus.appender.FILE.MaxFileSize=@LOG_OUTFILESIZE@
log4cplus.appender.FILE.MaxBackupIndex=5
log4cplus.appender.FILE.layout=log4cplus::PatternLayout
log4cplus.appender.FILE.layout.ConversionPattern=@LOG_OUTFILE@
