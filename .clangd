CompileFlags:
  # Point to the compile_commands.json in the build directory
  CompilationDatabase: build

  # Add these flags to all compile commands
  Add:
    - '-std=c++23'

  # Remove problematic flags that might confuse clangd
  Remove:
    - '-arch'
    - 'arm64'

# Configure diagnostics
Diagnostics:
  # Disable warnings from external headers (like SDL3, imgui)
  UnusedIncludes: None
  MissingIncludes: Strict
  
  # Suppress diagnostics from system headers
  Suppress:
    - 'pp_*'

# InlayHints configuration
InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

# Index configuration for better code navigation
Index:
  Background: Build
  StandardLibrary: Yes

# Completion settings
Completion:
  AllScopes: Yes

# Hover information
Hover:
  ShowAKA: Yes
